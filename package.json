{
  "name": "shizuoka-global-exchange-ai",
  "description": "小学校５・６年生向け 研究対象20名のAI留学生との1対1英語対話学習アプリ",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "qa:dialogue": "tsx scripts/qa-dialogue.ts",
    "build:pages": "vite build && cp dist/index.html dist/404.html",
    "build:server": "tsx scripts/build-server.ts",
    "build": "npm run build:pages && npm run build:server",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "qa:speech": "tsx scripts/test_speech_accumulation_qa.ts",
    "qa:security": "tsx scripts/qa-security.ts",
    "qa:data": "tsx scripts/qa-data-contract.ts",
    "qa:management": "tsx scripts/qa-management-page.ts",
    "qa:responsive-vocab": "tsx scripts/qa-responsive-vocabulary.ts",
    "qa:setup-columns": "tsx scripts/qa-setup-column-sync.ts",
    "qa:feedback-counts": "tsx scripts/qa-feedback-learning-counts.ts",
    "qa:persona-master": "tsx scripts/qa-persona-master.ts",
    "qa:20-persona-setup": "tsx scripts/qa-20-persona-setup.ts",
    "qa:azure-voice-profile": "tsx scripts/qa-azure-voice-profile.ts",
    "qa": "npm run qa:dialogue && npm run qa:speech && npm run qa:security && npm run qa:alignment && npm run qa:starter-translations && npm run qa:data && npm run qa:management && npm run qa:responsive-vocab && npm run qa:setup-columns && npm run qa:feedback-counts && npm run qa:research && npm run qa:dashboard && npm run qa:research-export && npm run qa:persona-master && npm run qa:20-persona-setup && npm run qa:azure-voice-profile && npm run lint && npm run qa:load",
    "qa:starter-translations": "tsx scripts/qa-starter-translations.ts",
    "qa:alignment": "tsx scripts/qa-dialogue-alignment.ts",
    "qa:research": "tsx scripts/qa-research-integrated.ts",
    "qa:dashboard": "tsx scripts/qa-dashboard-data-sync.ts",
    "qa:load": "tsx scripts/qa-research-run-load.ts",
    "qa:research-export": "tsx scripts/qa-research-export-complete.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
